#SERVICE CORE SETTINGS
DOCKERFILE=Dockerfile
SERVICE_NAME=sai-auth
SERVICE_VERSION=1.0.0

#Main service settings
SERVER_HOST=0.0.0.0 #Docker bind address
SERVER_PORT=8080 #Docker internal port or Application port
SERVER_EXTERNAL_PORT=8082 #Docker extrernal compose port
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=120

#Main logger settings
LOG_LEVEL=info
LOG_FORMAT=console
LOG_OUTPUT=stdout

#/health endpoint (JSON data)
HEALTH_ENABLED=true

#/docs endpoint (Swagger data)
DOCS_ENABLED=true

#Connected crossclient services
CLIENTS_ENABLED=true

#Storage client settings
STORAGE_URL=http://sai-storage:8080
STORAGE_AUTH_PROVIDER=token #OR basic OR auth
STORAGE_USERNAME=your-storage-user-here #AUTH_PROVIDER: basic
STORAGE_PASSWORD=your-storage-pass-here #AUTH_PROVIDER: basic
STORAGE_TOKEN=your-storage-secret-token-here #AUTH_PROVIDER: token

#Middlewares settings
MIDDLEWARES_ENABLED=true

#Host auth settings
AUTH_ENABLED=true
AUTH_PROVIDER=token #OR basic OR sai-auth
USERNAME=your-auth-user-here #AUTH_PROVIDER: basic
PASSWORD=your-auth-pass-here #AUTH_PROVIDER: basic
TOKEN=your-auth-secret-token-here #AUTH_PROVIDER: token
AUTH_SERVICE_URL=http://localhost:8080 #AUTH_PROVIDER: sai-auth | Client for auth service

#CORS middleware
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS='["*"]'
CORS_MAX_AGE=86400

#Logging middleware
LOGGING_ENABLED=true
LOGGING_LOG_LEVEL=debug
LOGGING_LOG_HEADERS=true
LOGGING_LOG_BODY=true

#Autorecovery middleware service
RECOVERY_ENABLED=true
RECOVERY_STACK_TRACE=true

#RateLimit middleware
RATELIMIT_ENABLED=true

#SPECIFIC SERVICE SETTINGS
ACCESS_TOKEN_TTL=3600s
REFRESH_TOKEN_TTL=86400s
BCRYPT_COST=12

SUPER_USER_IP_1=127.0.0.1
SUPER_USER_IP_2=::1
